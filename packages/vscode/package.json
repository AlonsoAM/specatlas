{
  "name": "specatlas-vscode",
  "displayName": "SpecAtlas",
  "description": "Spec-Driven Development con gates reales: specs vivas, trazabilidad, evidencia y mockups.",
  "version": "0.0.59",
  "license": "MIT",
  "publisher": "specatlas",
  "type": "module",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Visualization",
    "Testing"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "workspaceContains:**/.sdd/config.yaml",
    "onView:specatlas.now"
  ],
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/AlonsoAM/specatlas.git",
    "directory": "packages/vscode"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "specatlas",
          "title": "SpecAtlas",
          "icon": "media/atlas.svg"
        }
      ]
    },
    "views": {
      "specatlas": [
        {
          "id": "specatlas.now",
          "name": "Ahora",
          "icon": "media/atlas.svg"
        },
        {
          "id": "specatlas.explorer",
          "name": "Workspace SDD"
        },
        {
          "id": "specatlas.health",
          "name": "Salud",
          "visibility": "collapsed"
        },
        {
          "id": "specatlas.tools",
          "name": "Acciones",
          "visibility": "collapsed"
        }
      ]
    },
    "commands": [
      {
        "command": "specatlas.refresh",
        "title": "SpecAtlas: Refrescar",
        "icon": "$(refresh)",
        "enablement": "specatlas.initialized"
      },
      {
        "command": "specatlas.validate",
        "title": "SpecAtlas: Validar specs y deltas",
        "enablement": "specatlas.initialized"
      },
      {
        "command": "specatlas.trace",
        "title": "SpecAtlas: Verificar trazabilidad",
        "enablement": "specatlas.initialized"
      },
      {
        "command": "specatlas.waves",
        "title": "SpecAtlas: Calcular olas",
        "enablement": "specatlas.initialized"
      },
      {
        "command": "specatlas.analyze",
        "title": "SpecAtlas: Analizar un cambio",
        "enablement": "specatlas.hasChanges"
      },
      {
        "command": "specatlas.doctor",
        "title": "SpecAtlas: Diagnóstico del workspace",
        "enablement": "specatlas.initialized"
      },
      {
        "command": "specatlas.present",
        "title": "SpecAtlas: Generar propuesta para el stakeholder",
        "enablement": "specatlas.hasChanges"
      },
      {
        "command": "specatlas.mockup.open",
        "title": "SpecAtlas: Abrir mockups",
        "enablement": "specatlas.hasChanges"
      },
      {
        "command": "specatlas.approve",
        "title": "SpecAtlas: Aprobar (firmar) la spec",
        "enablement": "specatlas.hasChanges"
      },
      {
        "command": "specatlas.archive",
        "title": "SpecAtlas: Archivar el cambio",
        "enablement": "specatlas.hasChanges"
      },
      {
        "command": "specatlas.openPreview",
        "title": "SpecAtlas: Abrir vista previa"
      },
      {
        "command": "specatlas.copyNext",
        "title": "SpecAtlas: Copiar la siguiente acción",
        "enablement": "specatlas.hasChanges"
      },
      {
        "command": "specatlas.init",
        "title": "SpecAtlas: Inicializar workspace",
        "icon": "$(rocket)"
      },
      {
        "command": "specatlas.openAt",
        "title": "SpecAtlas: Abrir en la línea"
      },
      {
        "command": "specatlas.panel",
        "title": "SpecAtlas: Panel principal",
        "icon": "$(window)",
        "enablement": "specatlas.initialized"
      },
      {
        "command": "specatlas.adapters",
        "title": "SpecAtlas: Compilar adaptadores (comandos del agente)",
        "icon": "$(plug)",
        "enablement": "specatlas.initialized"
      },
      {
        "command": "specatlas.new",
        "title": "SpecAtlas: Nuevo cambio (fix · standard · full)",
        "icon": "$(add)",
        "enablement": "specatlas.initialized"
      },
      {
        "command": "specatlas.verify",
        "title": "SpecAtlas: Registrar evidencia de un escenario",
        "icon": "$(beaker)",
        "enablement": "specatlas.hasChanges"
      },
      {
        "command": "specatlas.packs",
        "title": "SpecAtlas: Evaluar packs de cumplimiento",
        "icon": "$(shield)",
        "enablement": "specatlas.initialized"
      },
      {
        "command": "specatlas.ci",
        "title": "SpecAtlas: CI (gate local)",
        "icon": "$(check-all)",
        "enablement": "specatlas.initialized"
      },
      {
        "command": "specatlas.mockups.decide",
        "title": "SpecAtlas: Decidir mockups del cambio (sí/no)",
        "icon": "$(device-mobile)",
        "enablement": "specatlas.hasChanges"
      },
      {
        "command": "specatlas.focusNow",
        "title": "SpecAtlas: Ir a «Ahora»",
        "icon": "$(compass)",
        "enablement": "specatlas.initialized"
      },
      {
        "command": "specatlas.focusHealth",
        "title": "SpecAtlas: Ir a «Salud»",
        "icon": "$(pulse)",
        "enablement": "specatlas.initialized"
      },
      {
        "command": "specatlas.drift",
        "title": "SpecAtlas: Anclas y deriva del código",
        "icon": "$(compass-dot)",
        "enablement": "specatlas.initialized"
      },
      {
        "command": "specatlas.impact",
        "title": "SpecAtlas: Impacto de un requisito o archivo",
        "icon": "$(references)",
        "enablement": "specatlas.initialized"
      },
      {
        "command": "specatlas.review",
        "title": "SpecAtlas: Revisión de código",
        "icon": "$(comment-discussion)",
        "enablement": "specatlas.hasChanges"
      },
      {
        "command": "specatlas.explain",
        "title": "SpecAtlas: Explicar un código de diagnóstico",
        "icon": "$(question)"
      },
      {
        "command": "specatlas.adopt",
        "title": "SpecAtlas: Adoptar un proyecto existente",
        "icon": "$(repo)"
      },
      {
        "command": "specatlas.watch",
        "title": "SpecAtlas: Vigilar el workspace (terminal)",
        "icon": "$(eye)",
        "enablement": "specatlas.initialized"
      },
      {
        "command": "specatlas.runNext",
        "title": "SpecAtlas: Ejecutar la siguiente acción",
        "icon": "$(play)",
        "enablement": "specatlas.hasChanges"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "specatlas.runNext",
          "when": "view == specatlas.now && specatlas.initialized",
          "group": "navigation@1"
        },
        {
          "command": "specatlas.panel",
          "when": "view == specatlas.now",
          "group": "navigation@2"
        },
        {
          "command": "specatlas.refresh",
          "when": "view == specatlas.now",
          "group": "navigation@3"
        },
        {
          "command": "specatlas.new",
          "when": "view == specatlas.explorer && specatlas.initialized",
          "group": "navigation@1"
        },
        {
          "command": "specatlas.refresh",
          "when": "view == specatlas.explorer",
          "group": "navigation@2"
        },
        {
          "command": "specatlas.init",
          "when": "view == specatlas.explorer && !specatlas.initialized",
          "group": "navigation@1"
        },
        {
          "command": "specatlas.ci",
          "when": "view == specatlas.health",
          "group": "navigation@1"
        },
        {
          "command": "specatlas.drift",
          "when": "view == specatlas.health",
          "group": "navigation@2"
        },
        {
          "command": "specatlas.refresh",
          "when": "view == specatlas.health",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "specatlas.runNext",
          "when": "view == specatlas.explorer && viewItem =~ /^action/",
          "group": "inline"
        },
        {
          "command": "specatlas.approve",
          "when": "view == specatlas.explorer && viewItem =~ /change-awaiting_approval/",
          "group": "inline"
        },
        {
          "command": "specatlas.verify",
          "when": "view == specatlas.explorer && viewItem =~ /change-(building|built|verified)/",
          "group": "inline"
        },
        {
          "command": "specatlas.verify",
          "when": "view == specatlas.explorer && viewItem =~ /change-(building|built|verified)/",
          "group": "1_ciclo@1"
        },
        {
          "command": "specatlas.approve",
          "when": "view == specatlas.explorer && viewItem =~ /change-awaiting_approval/",
          "group": "1_ciclo@2"
        },
        {
          "command": "specatlas.analyze",
          "when": "view == specatlas.explorer && viewItem =~ /^change/",
          "group": "1_ciclo@3"
        },
        {
          "command": "specatlas.trace",
          "when": "view == specatlas.explorer && viewItem =~ /^change/",
          "group": "1_ciclo@4"
        },
        {
          "command": "specatlas.waves",
          "when": "view == specatlas.explorer && viewItem =~ /^change/",
          "group": "1_ciclo@5"
        },
        {
          "command": "specatlas.packs",
          "when": "view == specatlas.explorer && viewItem =~ /^change/",
          "group": "1_ciclo@6"
        },
        {
          "command": "specatlas.present",
          "when": "view == specatlas.explorer && viewItem =~ /^change/",
          "group": "2_salidas@1"
        },
        {
          "command": "specatlas.mockups.decide",
          "when": "view == specatlas.explorer && viewItem =~ /^change/",
          "group": "2_salidas@1"
        },
        {
          "command": "specatlas.mockup.open",
          "when": "view == specatlas.explorer && viewItem =~ /^change/",
          "group": "2_salidas@2"
        },
        {
          "command": "specatlas.copyNext",
          "when": "view == specatlas.explorer && viewItem =~ /^change/",
          "group": "2_salidas@3"
        },
        {
          "command": "specatlas.archive",
          "when": "view == specatlas.explorer && viewItem =~ /change-(verified|ready)/",
          "group": "3_peligro@1"
        },
        {
          "command": "specatlas.openPreview",
          "when": "view == specatlas.explorer && viewItem =~ /^file/",
          "group": "inline"
        },
        {
          "command": "specatlas.verify",
          "when": "view == specatlas.explorer && viewItem =~ /file-(verify|fix)/",
          "group": "inline"
        },
        {
          "command": "specatlas.explain",
          "when": "view == specatlas.health && viewItem =~ /^healthDiagnostic/",
          "group": "inline"
        },
        {
          "command": "specatlas.drift",
          "when": "view == specatlas.health && viewItem == healthDrift",
          "group": "inline"
        },
        {
          "command": "specatlas.runNext",
          "when": "view == specatlas.now && viewItem =~ /^nowAction/",
          "group": "inline"
        },
        {
          "command": "specatlas.copyNext",
          "when": "view == specatlas.now && viewItem =~ /^nowAction/",
          "group": "1_ciclo@1"
        },
        {
          "command": "specatlas.panel",
          "when": "view == specatlas.now && viewItem =~ /^nowChange/",
          "group": "inline"
        },
        {
          "command": "specatlas.review",
          "when": "view == specatlas.now && viewItem == nowReview",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "specatlas.runNext",
          "when": "false"
        },
        {
          "command": "specatlas.focusNow",
          "when": "false"
        },
        {
          "command": "specatlas.focusHealth",
          "when": "false"
        },
        {
          "command": "specatlas.openAt",
          "when": "false"
        },
        {
          "command": "specatlas.openPreview",
          "when": "false"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "specatlas.now",
        "when": "!specatlas.initialized",
        "contents": "Este proyecto todavía no usa SpecAtlas.\n\nEl flujo guarda su estado en `.sdd/`: specs vivas, cambios, evidencia y firmas.\n\n[Inicializar workspace](command:specatlas.init)\n[Adoptar un proyecto existente](command:specatlas.adopt)\n\nSi es tu primera vez, el [tutorial](https://github.com/AlonsoAM/specatlas/blob/main/docs/tutorial/TUTORIAL.md) recorre el ciclo completo."
      },
      {
        "view": "specatlas.explorer",
        "when": "!specatlas.initialized",
        "contents": "[Inicializar workspace](command:specatlas.init)"
      }
    ],
    "configuration": {
      "title": "SpecAtlas",
      "properties": {
        "specatlas.autoValidate": {
          "type": "boolean",
          "default": true,
          "description": "Validar y actualizar Problems automáticamente al guardar archivos del repo."
        },
        "specatlas.lsp": {
          "type": "boolean",
          "default": true,
          "description": "Activar el servidor de lenguaje de SpecAtlas (diagnósticos, CodeLens, navegación y quick fixes en .sdd/)."
        }
      }
    },
    "walkthroughs": [
      {
        "id": "specatlas.primerosPasos",
        "title": "Empezar con SpecAtlas",
        "description": "El ciclo completo: del acuerdo escrito a la evidencia de que funciona.",
        "when": "true",
        "steps": [
          {
            "id": "specatlas.paso.inicializar",
            "title": "Inicializa el proyecto",
            "description": "SpecAtlas guarda su estado en `.sdd/`, dentro de tu repositorio.\n[Inicializar workspace](command:specatlas.init)\n[Adoptar un proyecto existente](command:specatlas.adopt)",
            "media": {
              "markdown": "media/walkthrough/inicializar.md"
            },
            "completionEvents": [
              "onContext:specatlas.initialized"
            ]
          },
          {
            "id": "specatlas.paso.cambio",
            "title": "Crea tu primer cambio",
            "description": "Nada se toca sin un cambio detrás: elige su carril y empieza.\n[Nuevo cambio](command:specatlas.new)",
            "media": {
              "markdown": "media/walkthrough/cambio.md"
            },
            "completionEvents": [
              "onContext:specatlas.hasChanges"
            ]
          },
          {
            "id": "specatlas.paso.especificar",
            "title": "Especifica en lenguaje de negocio",
            "description": "Qué y por qué, nunca cómo. La validación te dice dónde falla.\n[Validar especificaciones](command:specatlas.validate)",
            "media": {
              "markdown": "media/walkthrough/especificar.md"
            },
            "completionEvents": [
              "onCommand:specatlas.validate"
            ]
          },
          {
            "id": "specatlas.paso.aprobar",
            "title": "Aprueba con nombre y fecha",
            "description": "La firma guarda quién aprobó y la huella del documento.\n[Generar la propuesta](command:specatlas.present)\n[Firmar la aprobación](command:specatlas.approve)",
            "media": {
              "markdown": "media/walkthrough/aprobar.md"
            },
            "completionEvents": [
              "onCommand:specatlas.approve"
            ]
          },
          {
            "id": "specatlas.paso.evidencia",
            "title": "Cierra con evidencia",
            "description": "Terminado significa que hay un comando ejecutado que lo respalda.\n[Registrar evidencia](command:specatlas.verify)\n[Ver la trazabilidad](command:specatlas.trace)",
            "media": {
              "markdown": "media/walkthrough/evidencia.md"
            },
            "completionEvents": [
              "onCommand:specatlas.verify"
            ]
          }
        ]
      }
    ],
    "taskDefinitions": [
      {
        "type": "specatlas",
        "required": [
          "comprobacion"
        ],
        "properties": {
          "comprobacion": {
            "type": "string",
            "description": "Comprobación del flujo a ejecutar",
            "enum": [
              "ci",
              "validate",
              "trace",
              "drift",
              "doctor",
              "analyze"
            ]
          },
          "cambio": {
            "type": "string",
            "description": "Slug del cambio (solo para las comprobaciones que operan sobre uno)"
          }
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "specatlas-error",
        "owner": "specatlas",
        "source": "SpecAtlas",
        "severity": "error",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^ERROR\\s+([A-Z][A-Z0-9-]+)\\s+(\\S+?)(?::(\\d+))?\\s+—\\s+(.+)$",
          "code": 1,
          "file": 2,
          "line": 3,
          "message": 4
        }
      },
      {
        "name": "specatlas-aviso",
        "owner": "specatlas",
        "source": "SpecAtlas",
        "severity": "warning",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^AVISO\\s+([A-Z][A-Z0-9-]+)\\s+(\\S+?)(?::(\\d+))?\\s+—\\s+(.+)$",
          "code": 1,
          "file": 2,
          "line": 3,
          "message": 4
        }
      }
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup && node scripts/copy-assets.mjs",
    "package": "vsce package --no-dependencies --baseImagesUrl https://github.com/AlonsoAM/specatlas/raw/HEAD/packages/vscode --baseContentUrl https://github.com/AlonsoAM/specatlas/blob/HEAD/packages/vscode",
    "publish:vsce": "vsce publish --no-dependencies --baseImagesUrl https://github.com/AlonsoAM/specatlas/raw/HEAD/packages/vscode --baseContentUrl https://github.com/AlonsoAM/specatlas/blob/HEAD/packages/vscode",
    "publish:ovsx": "ovsx publish",
    "test:integracion": "tsc -p test-integracion/tsconfig.json && vscode-test"
  },
  "dependencies": {
    "@specatlas/adapters": "workspace:*",
    "@specatlas/core": "workspace:*",
    "@specatlas/lsp": "workspace:*",
    "@specatlas/render": "workspace:*",
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/vscode": "1.85.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.2.1",
    "mermaid": "^11.4.0",
    "mocha": "^12.0.2",
    "ovsx": "^0.10.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12"
  }
}
